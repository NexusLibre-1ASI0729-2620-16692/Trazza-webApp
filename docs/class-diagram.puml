package "Shared Kernel" as shared {
    package "Domain" as shared_domain {
        interface BaseEntity {
            + id: number
        }

        class Money <<value object>> {
            + {static} CURRENCIES: Record<string, string>
            - #amount: number
            - #currency: string
            + {static} zero(currency: string): Money
            + amount: number
            + currency: string
            + formatted: string
            + add(other: Money): Money
            + multiply(factor: number): Money
            + equals(other: Money): boolean
            + isGreaterThan(other: Money): boolean
            - #assertSameCurrency(other: Money): void
        }

        class Address <<value object>> {
            + {static} MIN_STREET_LENGTH: number
            - #street: string
            - #district: string
            + street: string
            + district: string
            + location: GeoLocation
            + fullAddress: string
            + equals(other: Address): boolean
        }

        class GeoLocation <<value object>> {
            + {static} EARTH_RADIUS_KM: number
            - #latitude: number
            - #longitude: number
            + latitude: number
            + longitude: number
            + distanceTo(other: GeoLocation): number
            + moveTowards(target: GeoLocation, fraction: number): GeoLocation
            + distanceToSegment(start: GeoLocation, end: GeoLocation): number
            + equals(other: GeoLocation): boolean
        }

        class LIMA_DISTRICTS <<catalog>> {
            + DISTRICT_NAMES: string[]
        }

        class Calendar <<utility>> {
            + todayIso(): string
            + currentMonthIso(): string
        }

        Address --> LIMA_DISTRICTS
        Address ..> GeoLocation
    }

    package "Application" as shared_application {
        class NotificationStore <<store>> {
            - notificationsSignal: WritableSignal<AppNotification[]>
            + notifications: Signal<AppNotification[]>
            + unreadCount: computed<number>
            + notify(props: {severity?: NotificationSeverity; summaryKey: string; detailKey?: string; params?: Record<string, string | number>}): void
            + markAllAsRead(): void
            + clear(): void
        }

        interface AppNotification {
            + id: number
            + severity: NotificationSeverity
            + summaryKey: string
            + detailKey: string
            + params: Record<string, string | number>
            + read: boolean
            + createdAt: string
        }

        class Collections <<utility>> {
            + upsertById(collection: T[], entity: T): T[]
            + replaceManyById(collection: T[], entities: T[]): T[]
            + byNewest(selector: (item: T) => string | null | undefined): (a: T, b: T) => number
        }

        NotificationStore *-- "0..*" AppNotification
    }

    package "Infrastructure" as shared_infrastructure {
        abstract class ErrorHandlingEnabledBaseType {
            # handleError(operation: string): (error: HttpErrorResponse) => Observable<never>
        }

        abstract class "BaseApiEndpoint<TEntity, TResource, TResponse, TAssembler>" as BaseApiEndpoint {
            # http: HttpClient
            # endpointUrl: string
            # assembler: TAssembler
            + getAll(filters: Record<string, string | number>): Observable<TEntity[]>
            + getById(id: number): Observable<TEntity>
            + create(entity: TEntity): Observable<TEntity>
            + update(entity: TEntity, id: number): Observable<TEntity>
            + delete(id: number): Observable<void>
        }

        abstract class BaseApi

        interface "BaseAssembler<TEntity, TResource, TResponse>" as BaseAssembler {
            + toEntityFromResource(resource: TResource): TEntity
            + toResourceFromEntity(entity: TEntity): TResource
            + toEntitiesFromResponse(response: TResponse): TEntity[]
        }

        interface BaseResource {
            + id: number
        }

        interface BaseResponse

        class SharedAssembler <<assembler>> {
            + {static} toAddress(resource: AddressResource): Address
            + {static} toAddressResource(address: Address): AddressResource
            + {static} toMoney(resource: MoneyResource): Money
            + {static} toMoneyResource(money: Money): MoneyResource
            + {static} toGeoLocation(resource: GeoLocationResource): GeoLocation
            + {static} toGeoLocationResource(location: GeoLocation): GeoLocationResource
        }

        interface AddressResource {
            + street: string
            + district: string
        }

        interface MoneyResource {
            + amount: number
            + currency: string
        }

        interface GeoLocationResource {
            + latitude: number
            + longitude: number
        }

        class HttpClient <<angular>>

        BaseApiEndpoint --|> ErrorHandlingEnabledBaseType
        BaseApiEndpoint --> HttpClient
        BaseApiEndpoint ..> BaseAssembler
        BaseApiEndpoint ..> BaseResource
        BaseApiEndpoint ..> BaseResponse
        BaseApiEndpoint ..> BaseEntity
        SharedAssembler ..> Address
        SharedAssembler ..> Money
        SharedAssembler ..> GeoLocation
        SharedAssembler ..> AddressResource
        SharedAssembler ..> MoneyResource
        SharedAssembler ..> GeoLocationResource
    }

    package "Presentation" as shared_presentation {
        class App <<component>>
        class Layout <<component>>
        class SideMenu <<component>>
        class TopBar <<component>>
        class FooterContent <<component>>
        class LanguageSwitcher <<component>>
        class AddressFields <<component>>
        class StatusTag <<component>>
        class EmptyState <<component>>
        class ConfirmDialog <<component>>
        class Dashboard <<view>>
        class PageNotFound <<view>>

        class BaseForm {
            # isInvalidControl(form: FormGroup, controlName: string): boolean
            # errorKeyForControl(form: FormGroup, controlName: string): string
        }

        class LocaleService <<service>> {
            - translate: TranslateService
            + language: Signal<string>
            + languages: string[]
            + use(language: string): void
            + instant(key: string, params: Record<string, string | number>): string
            + has(key: string): boolean
        }

        class FeedbackService <<service>> {
            + {static} ERROR_DURATION_MS: number
            + {static} SUCCESS_DURATION_MS: number
            - snackBar: MatSnackBar
            - locale: LocaleService
            + describeError(error: unknown): string
            + showError(error: unknown): void
            + showSuccess(key: string, params: Record<string, string | number>): void
        }

        class TrazzaTitleStrategy <<service>> {
            + {static} BRAND: string
            - title: Title
            - locale: LocaleService
            - titleKeySignal: WritableSignal<string>
            + titleKey: Signal<string>
            + updateTitle(snapshot: RouterStateSnapshot): void
        }

        class TitleStrategy <<angular>>

        class InitialsPipe <<pipe>>
        class TrazzaDatePipe <<pipe>>
        class TrazzaNumberPipe <<pipe>>
        class TrazzaTimePipe <<pipe>>

        App --> Layout
        Layout --> SideMenu
        Layout --> TopBar
        Layout --> LanguageSwitcher
        Layout --> FooterContent
        TopBar --> LanguageSwitcher
        TopBar --> NotificationStore
        TopBar --> LocaleService
        TopBar --> TrazzaTitleStrategy
        LanguageSwitcher --> LocaleService
        FeedbackService --> LocaleService
        TrazzaTitleStrategy --|> TitleStrategy
        TrazzaTitleStrategy --> LocaleService
        AddressFields ..> LIMA_DISTRICTS
    }
}


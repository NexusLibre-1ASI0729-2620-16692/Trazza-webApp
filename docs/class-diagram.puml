            + close(): void
        }

        class FreightRequest <<aggregate root>> {
            + {static} DATE_PATTERN: RegExp
            - #id: number
            - #code: string
            - #merchantId: number
            - #pickup: Address
            - #delivery: Address
            - #pickupDate: string
            - #pickupWindow: TimeWindow

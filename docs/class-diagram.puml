            - #durationMinutes: number
            - #createdAt: string | null
            + {static} create(props: Omit<ReturnRouteProps, 'status' | 'distanceKm' | 'durationMinutes' | 'createdAt'> & {today: string; vehicleCapacityKg: number; vehicleCapacityM3: number}): ReturnRoute
            + id: number
            + carrierId: number
            + vehicleId: number
            + vehicleLabel: string
            + origin: Address
            + destination: Address
            + departureDate: string
            + timeWindow: TimeWindow
            + availableWeightKg: number

        class MatchProposal <<aggregate root>> {
            - #id: number
            - #freightRequestId: number
            - #returnRouteId: number
            - #carrierId: number
            - #merchantId: number
            - #initiatedBy: Party
            - #currentRate: Money
            - #previousRate: Money | null
            - #lastOfferBy: Party
            - #status: ProposalStatus
            - #detour: Detour
            - #createdAt: string | null
            - #updatedAt: string | null
            + {static} create(props: {freightRequest: FreightRequest; returnRoute: ReturnRoute; rate: Money; by: Party; detour: Detour}): MatchProposal
            + id: number
            + freightRequestId: number
            + returnRouteId: number
            + carrierId: number
            + merchantId: number
            + initiatedBy: Party
            + currentRate: Money
            + previousRate: Money | null
            + lastOfferBy: Party
            + status: ProposalStatus
            + detour: Detour
            + createdAt: string | null
            + updatedAt: string | null
            + isAwaiting(party: string | null): boolean
            + accept(by: string): void
            + counter(rate: Money, by: string): void
            + reject(by: string): void
            + confirm(by: string): void
            + close(): void
            - #assertCanAnswer(by: string): void
            - #touch(): void
        }

        class TimeWindow <<value object>> {
            + {static} PATTERN: RegExp
            - #start: string
            - #end: string
            + {static} toMinutes(time: string): number
            + start: string
            + end: string
            + label: string
            + overlaps(other: TimeWindow): boolean
        }

        class Cargo <<value object>> {
            + {static} MAX_WEIGHT_KG: number
            + {static} MAX_DESCRIPTION_LENGTH: number
            - #type: CargoType
            - #weightKg: number
            - #volumeM3: number
            - #description: string
            + type: CargoType
            + weightKg: number
            + volumeM3: number
            + description: string
        }

        class CargoType <<value object>> {
            + {static} VALUES: CargoTypeValue[]
            - #value: CargoTypeValue

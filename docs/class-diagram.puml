            + target: RatingTarget
            + score: Score
            + tags: string[]
            + comment: string
            + createdAt: string
        }

        class Score <<value object>> {
            + {static} MIN: number
            + {static} MAX: number
            - #value: number
            + value: number
            + isPositive: boolean
        }

        class RatingTarget <<value object>> {
            + {static} TAGS: Record<RatingTargetRole, string[]>
            - #userId: number
            - #role: RatingTargetRole
            - #name: string
            + userId: number
            + role: RatingTargetRole
            + name: string
            + allowedTags: string[]
        }

        Rating ..|> BaseEntity
        Rating *-- Score
        Rating *-- RatingTarget
    }

    package "Application" as reputation_application {
        class ReputationStore <<store>> {
            - reputationApi: ReputationApi
            - iamStore: IamStore
            - ratingsSignal: WritableSignal<Rating[]>
            - loadingSignal: WritableSignal<boolean>
            - errorSignal: WritableSignal<string | null>
            + ratings: Signal<Rating[]>
            + loading: Signal<boolean>
            + error: Signal<string | null>
            + myReceivedRatings: computed<Rating[]>
            + myGivenRatings: computed<Rating[]>
            + mySummary: computed<ReputationSummary>
            + loadRatings(): void
            + ratingsReceivedBy(userId: number | null): Rating[]
            + summaryFor(userId: number | null): ReputationSummary
            + ratingForShipmentBy(shipmentId: number, raterId: number | null): Rating | undefined
            + submitRating(props: {shipment: Shipment; score: number; tags: string[]; comment: string}): Observable<Rating>
        }

        interface ReputationSummary {
            + average: number
            + count: number
            + distribution: number[]
        }

        ReputationStore ..> ReputationSummary
    }

    package "Infrastructure" as reputation_infrastructure {
        class ReputationApi <<facade>> {
            - http: HttpClient
            - ratingsEndpoint: RatingsApiEndpoint
            + getRatings(): Observable<Rating[]>
            + createRating(rating: Rating): Observable<Rating>
        }

        class RatingsApiEndpoint <<endpoint>>

        class RatingAssembler <<assembler>> {
            + {static} toEntityFromResource(resource: RatingResource): Rating
            + {static} toEntitiesFromResponse(response: RatingsResponse): Rating[]
            + {static} toResourceFromEntity(entity: Rating): RatingResource
        }

        interface RatingResource
        interface RatingsResponse

        ReputationApi --|> BaseApi
        ReputationApi --> RatingsApiEndpoint
        RatingsApiEndpoint --|> BaseApiEndpoint
        RatingsApiEndpoint --> RatingAssembler
        RatingAssembler ..> Rating
        RatingAssembler ..> RatingResource
        RatingAssembler ..> RatingsResponse
        RatingResource --|> BaseResource
        RatingsResponse --|> BaseResponse
    }

    package "Presentation" as reputation_presentation {
        class RatingList <<view>>
        class RatingDialog <<component>>
        class StarRating <<component>>

        RatingList --> StarRating
        RatingDialog --> StarRating
    }

    ReputationStore --> ReputationApi
    RatingList --> ReputationStore
    RatingDialog --> ReputationStore
}


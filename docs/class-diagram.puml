            - #value: ProposalStatusValue
            + value: ProposalStatusValue
            + isNegotiating: boolean
            + isAccepted: boolean
            + isOpen: boolean
        }

        enum Party {
            carrier
            merchant
        }

        class RouteMatchingService <<domain service>> {
            + {static} ROAD_FACTOR: number
            + {static} AVERAGE_SPEED_KMH: number
